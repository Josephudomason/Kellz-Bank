# Supabase project settings (use the public/publishable key in browser code).
NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL connection strings. DATABASE_URL may use Supabase's pooler;
# DIRECT_URL should be a direct connection used by Prisma migrations.
DATABASE_URL=

DIRECT_URL=

# Plaid Sandbox credentials; PLAID_SECRET must remain server-side.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_TOKEN_ENCRYPTION_KEY=


NEXT_PUBLIC_APP_URL=http://localhost:3000

